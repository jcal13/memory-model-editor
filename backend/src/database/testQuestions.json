      "self.price = p",
      "",
      "def update_price(self, new_price: int) -> None:",
      "\\\"\\\"\\\"Update this Food's price to new_price.\\\"\\\"\\\"",
      "price = self.price",
      "price = new_price",
      "",
      "class Fries(Food):",
      "def __init__(self, p: int) -> None:",
      "Food.__init__(self, 'fries', p)",
      "",
